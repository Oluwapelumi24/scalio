{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --workspace=@veno/shared-types && npm run build --workspace=apps/admin-web",
    "watchPatterns": [
      "/apps/admin-web/**",
      "/packages/**",
      "/package.json",
      "/package-lock.json",
      "/apps/admin-web/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "sh -c 'cd apps/admin-web && npm run start'",
    "healthcheckPath": "/login",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}

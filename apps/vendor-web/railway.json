{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --workspace=apps/vendor-web",
    "watchPatterns": ["apps/vendor-web/**", "packages/**", "package.json", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "npm run start --workspace=apps/vendor-web",
    "healthcheckPath": "/login",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}

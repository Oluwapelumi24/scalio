DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scalio
REDIS_URL=redis://localhost:6379
PORT=3000

# Email OTP verification (PRD §4.1 step 7) — sent via Resend
RESEND_API_KEY=
MAIL_FROM="Scalio <onboarding@resend.dev>"

# Payments (PRD §9.3) — Paystack handles `deposit`/`full_prepayment` bookings.
# The same secret key is used to sign/verify webhook payloads.
PAYSTACK_SECRET_KEY=

# Vendor admin auth — staff sign in with email+password (accounts are
# platform-provisioned, then activated via an emailed invite link).
VENDOR_JWT_SECRET=
VENDOR_WEB_URL="http://localhost:3001"

# Base URL of the public booking pages (apps/website /book/[slug]); used for "Share booking link".
PUBLIC_BOOKING_URL="http://localhost:3003/book"

# Phase 3 — money. Scalio never holds funds: online payments settle to each
# vendor's own bank through their Paystack subaccount.
# Scalio's commission on each online payment, in percent (0 = none).
PLATFORM_COMMISSION_PERCENT=0
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts bank account numbers
# at rest. Required in production; a dev-only key is used locally if unset.
PII_ENCRYPTION_KEY=

# Phase 4 — content studio. AI captions are written by Claude on the backend only.
# Leave empty to switch AI captions off (vendors can still write their own).
ANTHROPIC_API_KEY=
# AI captions each business can generate per day.
CONTENT_AI_DAILY_LIMIT=40

# Phase 4 — posting to Facebook Pages and Instagram (Meta). Leave empty to keep
# posting manual. Create the app at developers.facebook.com (free).
META_APP_ID=
META_APP_SECRET=
# Optional: a "Facebook Login for Business" configuration id. If unset, the
# individual permissions are requested instead.
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v25.0
# Public https:// address of this API. Meta redirects logins to
# $PUBLIC_API_URL/social/meta/callback (add that to the app's Valid OAuth Redirect
# URIs) and fetches photos from $PUBLIC_API_URL/public/content-media/... when posting.
# In local development, use a tunnel (e.g. cloudflared or ngrok) to get one.
PUBLIC_API_URL=
# Signs the short-lived photo links Meta fetches. Falls back to VENDOR_JWT_SECRET.
MEDIA_URL_SECRET=

# Test environments only (local / UAT): a fixed 6-digit code that resets any
# vendor password without email. NEVER set in production — the server refuses
# to start if NODE_ENV=production and this is set.
DEV_RESET_CODE=

# Phase 5 — base URL of the public rating page (apps/website /feedback/[token]).
# Defaults to PUBLIC_BOOKING_URL with /book swapped for /feedback.
PUBLIC_FEEDBACK_URL="http://localhost:3003/feedback"

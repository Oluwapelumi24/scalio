{
  "expo": {
    "name": "Scalio Vendor",
    "slug": "scalio-vendor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.scalio.vendor"
    },
    "android": {
      "package": "com.scalio.vendor"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Scalio uses your photos so you can add them to social media posts.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}

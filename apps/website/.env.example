# Public API used by server components and server actions (Railway backend).
API_URL=https://api.venohq.com

# Same value as the backend INTERNAL_PROXY_SECRET (≥32 chars). Lets server
# actions forward the real browser IP for per-user rate limits.
INTERNAL_PROXY_SECRET=

# Seller dashboard (Railway vendor-web). Required in production so login hands
# off to the real product instead of /business on this marketing site.
# Use the same value for both until app.venohq.com DNS is live.
VENDOR_WEB_URL=https://vendor-web-production-xxxx.up.railway.app
NEXT_PUBLIC_VENDOR_WEB_URL=https://vendor-web-production-xxxx.up.railway.app

# Optional: only if you want /register and /login links in the navbar to leave
# this site. Without NEXT_PUBLIC_*, server handoff still works via VENDOR_WEB_URL.
